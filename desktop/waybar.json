{
  "layer": "top",
  "position": "top",
  "height": 39,
  "margin-left": 20,
  "margin-right": 20,
  "modules-left": ["custom/launcher"],
  "modules-center": ["clock"],
  "modules-right": ["backlight", "pulseaudio", "network", "battery", "custom/notifications"],
  "custom/launcher": {
    "format": "Aplicaciones",
    "on-click": "fuzzel --config=/etc/fuzzel/acer.ini",
    "tooltip-format": "Abrir aplicaciones (Super + D)"
  },
  "clock": {
    "format": "{:%H:%M}   <span color='#c7b8c4'>{:%d/%m}</span>",
    "tooltip-format": "{:%d/%m/%Y}"
  },
  "backlight": { "format": "Brillo {percent}%", "min-brightness": 5.0 },
  "pulseaudio": {
    "format": "Vol. {volume}%",
    "format-muted": "Silencio",
    "scroll-step": 5.0,
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
  },
  "network": {
    "format-wifi": "Wi-Fi {signalStrength}%",
    "format-ethernet": "Ethernet",
    "format-disconnected": "Sin red"
  },
  "battery": {
    "states": { "warning": 25, "critical": 12 },
    "format": "Batería {capacity}%",
    "format-charging": "Cargando {capacity}%"
  },
  "custom/notifications": {
    "format": "Notificaciones",
    "on-click": "swaync-client -t"
  }
}
